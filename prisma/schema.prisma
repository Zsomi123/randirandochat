generator client {
  provider        = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// --- NEXTAUTH KÖTELEZŐ TÁBLÁK ---

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String? @db.Text
  access_token       String? @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String? @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// --- A TE FELHASZNÁLÓI TÁBLÁD FELFEJLESZTVE ---

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?

  // Randirandochat egyedi adatok (opcionálisak, mert bejelentkezés után tölti ki őket)
  becenev       String?
  kor           Int?
  nem           String?
  keresettNem   String?
  megyek        String[]
  hobbik        String[]

  // --- PRÉMIUM ÉS STRIPE ADATOK ---
  isPremium        Boolean @default(false)
  stripeCustomerId String? @unique

  isAdmin   Boolean   @default(false)

  // --- ÚJ: UTOLSÓ ISMERT IP (admin IP-keresés miatt) ---
  lastIp    String?

  // --- ÚJ: EGYEDI NAPI LIMIT FELÜLÍRÁS ---
  // Ha null, az alapértelmezett (globális) napi limit érvényes rá.
  // Ha admin beállít egy számot, az felülírja azt erre a felhasználóra.
  napiLimitOverride Int?

  // --- ÚJ: KITILTÁS (a tényleges banrendszer még nincs kiépítve,
  // de az admin felület már tud vele dolgozni) ---
  isBanned    Boolean   @default(false)
  bannedUntil DateTime? // ha null és isBanned true, az végleges tiltást jelent
  banReason   String?

  accounts      Account[]
  sessions      Session[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model NapiLimit {
  azonosito String  @id // Ide mentjük be az IP címet (pl. "ip_123.45.67.89") – ez alapján megy a tiltás
  email     String? // A limitet kiváltó felhasználó legutóbb használt email címe (csak infó, nem kulcs)
  hasznalt  Int     @default(0)
  datum     String  // Mai dátum (pl. "2026-07-22"), így éjfélkor magától "nullázódik"
}

// --- ÚJ: IP CÍM ALAPÚ KITILTÁS ---
// Eddig a kitiltás kizárólag a User.isBanned/bannedUntil/banReason mezőkön
// (tehát az email címen) keresztül érvényesült - ezt egy új Google-fiókkal
// könnyen meg lehetett kerülni. Ez a tábla magát az IP címet tiltja ki,
// függetlenül attól, hogy utána melyik email/fiók próbál párosítani róla.
// A kulcs a NapiLimit táblával megegyező, megtisztított IP cím (nyers, "ip_"
// előtag NÉLKÜL), hogy egyértelműen elkülönüljön a NapiLimit azonosítóitól.
model BannedIp {
  ip          String    @id
  reason      String?
  bannedUntil DateTime? // null = végleges tiltás
  createdAt   DateTime  @default(now())
  // Melyik felhasználó (email) miatt/kapcsán került be ez az IP a listára - csak infó.
  sourceEmail String?
}

// --- ÚJ: JELENTÉS (REPORT) RENDSZER ---
// Egy chat közben leadott jelentés: ki jelentette, kit, milyen okkal, és a hozzá
// csatolt beszélgetés-napló. Az admin felület ("Jelentések" fül) ez alapján dolgozik,
// és innen indul a tényleges kitiltás (User.isBanned / bannedUntil / banReason) is.
model Report {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  // --- BEJELENTŐ ---
  reporterEmail String
  reporterNev   String?

  // --- CÉLPONT (a jelentett felhasználó) ---
  targetEmail String
  targetNev   String?

  // --- A JELENTÉS TARTALMA ---
  okok      String[] // pl. ["Sértő megjegyzések", "Spam / Bot"]
  reszletek String?  @db.Text
  chatLog   Json     // a beszélgetés naplója a jelentés pillanatában (a frontend Uzenet[] típusa)

  // --- ELBÍRÁLÁS ÁLLAPOTA ---
  statusz String @default("fuggo") // fuggo | folyamatban | megoldott | elutasitott

  elbiraloEmail String?
  elbiraltIdo   DateTime?

  // --- A CÉLPONTRA KISZABOTT SZANKCIÓ (ha az admin alkalmazott ilyet) ---
  celpontSzankcioIndoklas    String?   @db.Text
  celpontSzankcioLejarat     DateTime? // null = végleges tiltás (ha celpontSzankcioAlkalmazva = true)
  celpontSzankcioAlkalmazva  Boolean   @default(false)

  // --- A BEJELENTŐRE KISZABOTT SZANKCIÓ (pl. alaptalan/rosszhiszemű jelentés esetén) ---
  bejelentoSzankcioIndoklas   String?   @db.Text
  bejelentoSzankcioLejarat    DateTime?
  bejelentoSzankcioAlkalmazva Boolean   @default(false)

  @@index([reporterEmail])
  @@index([targetEmail])
  @@index([statusz])
}

// --- ÚJ: FELLEBBEZÉS (a kitiltás ellen) ---
// Csak Prémium felhasználók nyújthatnak be fellebbezést egy aktív kitiltás
// ellen (lásd /api/appeals route.ts). Az admin felület külön "Fellebbezések"
// fülön bírálja el - elfogadás esetén a felhasználó (és az IP-je) tiltása
// feloldásra kerül.
model Fellebbezes {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  userEmail String
  userNev   String?
  uzenet    String   @db.Text

  // A tiltás adatainak pillanatképe a fellebbezés beküldésekor (hogy akkor is
  // látható maradjon, ha időközben a tiltás bármi miatt megváltozna)
  bannedUntil DateTime?
  banReason   String?

  statusz String @default("fuggo") // fuggo | elfogadva | elutasitva

  adminValasz   String?   @db.Text
  elbiraloEmail String?
  elbiraltIdo   DateTime?

  @@index([userEmail])
  @@index([statusz])
}
